# ==============================================================================
# Slip Churn Intelligence Backend — Environment Variables Example
# ==============================================================================

# --- 1. Server Configuration ---
PORT=7860
HOST=0.0.0.0
ENVIRONMENT=development

# --- 2. AI & LLM Provider API Keys (At least one is recommended for live AI reasoning) ---

# Google AI Studio API Key (Get one for free at https://aistudio.google.com/)
GOOGLE_API_KEY=your_gemini_api_key_here

# Groq API Key (Get one for free at https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here

# Mistral AI API Key (Get one for free at https://console.mistral.ai/)
MISTRAL_API_KEY=your_mistral_api_key_here

# --- 3. Embeddings & Vector Store ---
# Optional: Hugging Face User Access Token (to avoid rate limits when downloading embeddings)
# https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here
